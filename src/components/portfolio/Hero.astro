---
---

<section id="top" class="mx-auto max-w-6xl px-5 pt-28 pb-20 md:pt-32 md:pb-28">
  <p class="mb-4 flex justify-between text-sm text-muted animate-in">
    <span>프론트엔드 개발자</span>
    <span>3+년 경력</span>
  </p>

  <h1
    class="font-display text-[clamp(2.8rem,15.5vw,13.5rem)] font-bold leading-[0.82] tracking-[-0.05em]"
  >
    <span class="hero-line"><span class="hero-line-inner">Choi</span></span>
    <span class="hero-line"><span class="hero-line-inner">Yunsung<span class="text-accent">.</span></span></span>
  </h1>

  <div class="mt-14 grid gap-12 border-t border-ink pt-8 md:mt-20 md:grid-cols-[1.4fr_1fr] md:gap-16">
    <div class="animate-in">
      <p class="whitespace-pre-line text-3xl font-semibold leading-snug tracking-tight md:text-[2.6rem] md:leading-[1.2]">
        <span>"원래 그런 거야"를</span><br />
        <span class="relative inline-block whitespace-nowrap">
          끝까지
          <svg aria-hidden="true" viewBox="0 0 200 14" preserveAspectRatio="none" class="squiggle absolute -bottom-1 left-0 h-[0.28em] w-full text-accent">
            <path d="M2 9 C 30 2, 50 12, 80 7 S 140 3, 198 8" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"></path>
          </svg>
        </span>
        <span> 파고드는 개발자입니다.</span>
      </p>
      <p class="mt-6 max-w-lg text-lg text-muted">
        이틀씩 손으로 하던 일도, 매번 다시 만들던 화면도 — 왜 반복되는지부터 파고들어 원인을 없앱니다.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="#projects" class="btn-primary">프로젝트 보기 ↓</a>
        <a href="https://github.com/GSMYunsung" target="_blank" rel="noreferrer" class="ulink text-sm font-medium">GitHub ↗</a>
        <a href="#contact" class="ulink text-sm font-medium">Contact ↗</a>
      </div>
    </div>

    <dl class="animate-in self-start" style="--stagger: 120ms">
      {[
        { label: '지금', value: '사이드 프로젝트 · 기술 블로그' },
        { label: '경력', value: '2022 — 현재' },
        { label: '주력', value: 'React · TypeScript' },
        { label: '스택', value: 'Next.js · Remix · React Native' },
      ].map((row) => (
        <div class="grid grid-cols-[4.5rem_1fr] gap-4 border-b border-line py-3.5 first:pt-0">
          <dt class="font-serif text-lg italic text-muted">{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .hero-line-inner {
    display: block;
    transform: translateY(100%);
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.hero-line-inner').forEach((span, i) => {
    if (reduced) {
      span.style.transform = 'translateY(0)';
      return;
    }
    span.animate(
      [{ transform: 'translateY(100%)' }, { transform: 'translateY(0)' }],
      { duration: 700, delay: 150 + i * 90, easing: 'cubic-bezier(0.23,1,0.32,1)', fill: 'forwards' }
    );
  });
</script>
