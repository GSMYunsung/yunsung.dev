---
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="border-t border-line bg-bg text-ink">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-24 md:grid-cols-[11rem_1fr] md:gap-12 md:py-36">
    <div class="animate-in">
      <h2 class="font-serif text-2xl italic md:sticky md:top-24 md:text-3xl">프로젝트</h2>
    </div>

    <div>
      <p class="mb-8 text-muted">최신순 · 항목을 눌러 문제와 해결 과정을 확인하세요.</p>

      <ul class="border-t-2 border-ink">
        {allProjects.map((project, i) => {
          const { title, period, description, techStack, role, problem, solution, contribution } = project.data;
          const panelId = `panel-${project.id}`;
          return (
            <li class="border-b border-line">
              <button
                type="button"
                class="accordion-trigger group grid w-full grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 py-6 text-left md:grid-cols-[7.5rem_1fr_auto]"
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={panelId}
              >
                <span class="order-2 col-span-2 text-sm text-muted md:order-none md:col-span-1">{period}</span>
                <span class="order-1 md:order-none">
                  <span class="block font-display text-xl font-bold tracking-tight transition group-hover:text-accent md:text-2xl">
                    {title}
                  </span>
                  <span class="mt-1 block text-muted">{description}</span>
                </span>
                <span class="accordion-icon order-1 text-2xl leading-none text-accent md:order-none">+</span>
              </button>

              <div id={panelId} class={`accordion-panel ${i === 0 ? 'open' : ''}`}>
                <div class="grid gap-8 pb-10 md:grid-cols-[7.5rem_1fr]">
                  <div class="hidden md:block"></div>
                  <div class="space-y-6">
                    {role && (
                      <div class="grid gap-1 md:grid-cols-[7rem_1fr] md:gap-6">
                        <h4 class="font-serif text-lg italic text-muted">Role</h4>
                        <div class="leading-relaxed">{role}</div>
                      </div>
                    )}
                    {problem && (
                      <div class="grid gap-1 md:grid-cols-[7rem_1fr] md:gap-6">
                        <h4 class="font-serif text-lg italic text-muted">Problem</h4>
                        <div class="leading-relaxed">{problem}</div>
                      </div>
                    )}
                    {solution && (
                      <div class="grid gap-1 md:grid-cols-[7rem_1fr] md:gap-6">
                        <h4 class="font-serif text-lg italic text-muted">Solution</h4>
                        <div class="leading-relaxed">{solution}</div>
                      </div>
                    )}
                    {contribution && contribution.length > 0 && (
                      <div class="grid gap-1 md:grid-cols-[7rem_1fr] md:gap-6">
                        <h4 class="font-serif text-lg italic text-muted">Contribution</h4>
                        <ul class="space-y-1.5">
                          {contribution.map((item) => (
                            <li class="flex gap-3">
                              <span class="text-accent">→</span>{item}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                    <div class="grid gap-1 md:grid-cols-[7rem_1fr] md:gap-6">
                      <h4 class="font-serif text-lg italic text-muted">Tech</h4>
                      <p class="text-muted">{techStack.join(' · ')}</p>
                    </div>
                    <a href={`/projects/${project.id}`} class="ulink inline-block text-sm font-medium text-accent">
                      자세히 보기 ↗
                    </a>
                  </div>
                </div>
              </div>
            </li>
          );
        })}
      </ul>

      <div class="mt-10">
        <a href="https://github.com/GSMYunsung" target="_blank" rel="noopener" class="ulink text-sm font-medium">
          GitHub에서 더 보기 ↗
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.accordion-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls')!);
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      panel?.classList.toggle('open', !isOpen);
    });
  });
</script>
