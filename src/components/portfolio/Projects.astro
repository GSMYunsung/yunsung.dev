---
import { getCollection } from 'astro:content';
import ProjectAccordionList from './ProjectAccordionList.astro';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const companyCategories = ['CNAI', '팀오투'];
const companyProjects = allProjects.filter((p) => companyCategories.includes(p.data.category));
const personalProjects = allProjects.filter((p) => !companyCategories.includes(p.data.category));
---

<section id="projects" class="border-t border-line bg-bg text-ink">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-24 md:grid-cols-[11rem_1fr] md:gap-12 md:py-36">
    <div class="animate-in">
      <h2 class="font-serif text-2xl italic md:sticky md:top-24 md:text-3xl">프로젝트</h2>
    </div>

    <div>
      <p class="mb-8 text-muted">최신순 · 항목을 눌러 문제와 해결 과정을 확인하세요.</p>

      <div class="mb-16">
        <h3 class="mb-6 border-b-2 border-ink pb-2 font-display text-2xl font-bold tracking-tight md:text-3xl">
          회사 프로젝트
        </h3>
        <ProjectAccordionList projects={companyProjects} />
      </div>

      <div>
        <h3 class="mb-6 border-b-2 border-ink pb-2 font-display text-2xl font-bold tracking-tight md:text-3xl">
          개인 프로젝트
        </h3>
        <ProjectAccordionList projects={personalProjects} />
      </div>

      <div class="mt-10">
        <a href="https://github.com/GSMYunsung" target="_blank" rel="noopener" class="ulink text-sm font-medium">
          GitHub에서 더 보기 ↗
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.accordion-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls')!);
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      panel?.classList.toggle('open', !isOpen);
    });
  });
</script>
