---
import { aiNotes } from '../../data/aiNotes';
---

<section id="ai-note" class="py-16 px-4 sm:px-8 max-w-7xl mx-auto">
  <div style="border-top: 1px solid #262626;" class="pt-12">

    <div class="flex flex-col lg:flex-row gap-16">
      <!-- Left label -->
      <div class="lg:w-48 shrink-0">
        <p class="text-xs tracking-widest uppercase" style="color:#b5f23d;">AI Note</p>
      </div>

      <!-- Right content -->
      <div class="flex-1">
        <p class="text-sm mb-12 max-w-2xl" style="color:#888888; line-height:1.9;">
          AI를 "대신 코드를 짜주는 도구"보다는, <strong style="color:#c8c8c8;font-weight:600;">반복되는 판단과 안전장치를 고정해두는 쪽</strong>으로 더 많이 써왔습니다. 큰 틀과 수치를 먼저 보여드리고, 항목을 누르면 더 자세한 기록으로 이어집니다.
        </p>

        <div>
          {aiNotes.map((note, i) => (
            <a
              href={`/ai/${note.slug}`}
              class="group block py-6 transition-colors animate-in"
              style={`border-top: 1px solid #1e1e1e; --stagger: ${i * 60}ms;`}
            >
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 sm:gap-6">
                <div class="flex gap-4 flex-1 min-w-0">
                  <span class="text-xs shrink-0 mt-1" style="color:#444444;">{note.number}</span>
                  <div class="min-w-0">
                    <p class="text-base font-semibold mb-1.5 transition-colors group-hover:text-[#b5f23d]" style="color:#e8e8e8;">
                      {note.title}
                    </p>
                    <p class="text-sm" style="color:#888888; line-height:1.7;">
                      {note.summary}
                    </p>
                  </div>
                </div>
                <div class="shrink-0 pl-9 sm:pl-0 sm:w-56 sm:text-right">
                  <p class="text-2xl font-black tracking-tight" style="color:#b5f23d;">{note.stat}</p>
                  <p class="text-xs mt-1" style="color:#555555;">{note.statCaption}</p>
                </div>
              </div>
            </a>
          ))}
        </div>

        <p class="text-sm mt-10" style="color:#555555; line-height:1.8;">
          전체 스킬 구조는 <a href="/blog/2026-10-28-ai-skill-system-blog" style="color:#b5f23d;">블로그 글</a>에 정리했습니다.
        </p>
      </div>
    </div>

  </div>
</section>
