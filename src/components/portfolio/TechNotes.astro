---
import FlowStep from './FlowStep.astro';

interface Value {
  title: string;
  skills: string;
  stat: string;
  statCaption: string;
  problem: string;
  analysis: string;
  result: string;
}

const values: Value[] = [
  {
    title: '착수 전에 의도부터 확정',
    skills: 'clarify-intent · bugfix-cycle',
    stat: '3',
    statCaption: '모든 코드 변경 요청이 거치도록 강제한 체인 단계 수',
    problem: '"고쳐줘", "바꿔줘"처럼 해결 방법이 뭉뚱그려진 요청에서, 빠르게 고치는 것과 정확히 원하는 걸 고치는 것의 차이가 자주 드러났습니다.',
    analysis: '요청을 받자마자 코드를 고치는 방식과 의도부터 확인하고 착수하는 방식을 비교했습니다. 의도 확인 없이 진행하면 "원한 건 이게 아니었는데"가 반복된다고 판단했습니다.',
    result: '의도 파악 → 이슈·브랜치·PR로 추적 가능하게 만들기 → 검증, 3단계를 모든 코드 변경에 강제했습니다. 오타 수정처럼 의도가 명백한 경우만 예외입니다.',
  },
  {
    title: '반복은 설명하지 않고 고정',
    skills: '전역 스킬 12개 · 프로젝트 전용 스킬 6개',
    stat: '18개',
    statCaption: '직접 설계해 4개 프로젝트에서 운영 중인 스킬 수',
    problem: '같은 지시를 매번 새로 설명해야 하는 반복이 쌓였습니다. "고쳐줘" 한마디로도 판단 기준이 달라지면 안 됐습니다.',
    analysis: '필요할 때마다 즉흥적으로 스킬을 추가하는 방식과, 어떤 역할 분담이 필요한지 먼저 설계하는 방식을 비교했습니다. 즉흥 추가는 비슷한 역할의 스킬이 중복되는 문제가 있어 설계를 먼저 하는 쪽을 선택했습니다.',
    result: '작업 절차·디자인·프론트엔드 구현·프로젝트별 반복 작업까지 역할을 나눠 스킬 18개로 운영합니다. 디자인 요청 한마디를 트렌드 수집 → 브리프 → Figma MCP → 코드 반영까지 묶은 design-flow처럼, 반복되는 판단은 스킬 하나로 고정해 둡니다.',
  },
  {
    title: '위험에 비례한 절차',
    skills: 'bugfix-cycle',
    stat: '7 → 3',
    statCaption: '전체 7단계 사이클 중 Low 등급 버그가 실제로 거치는 단계 수',
    problem: '버그 수정 요청마다 "이게 심각한 문제인지, 그냥 넘어가도 되는지"를 매번 설명해야 하는 게 번거로웠습니다.',
    analysis: '모든 버그에 같은 무게의 절차를 적용하는 방식과, 위험도에 따라 중간 단계를 생략하는 방식을 비교했습니다. 판단 기준 자체를 스킬 안에 넣어두면 매번 설명할 필요가 없어진다고 판단했습니다.',
    result: '판단 → 탐색 → 구현 → 테스트 → 자가검증 → 기록 → 배포 7단계 중, Low 등급은 판단 → 기록 → 배포 3단계만 거치도록 줄였습니다.',
  },
  {
    title: '완료는 근거로 판정',
    skills: 'verify-solution · maestro-test · evidence-audit',
    stat: '4',
    statCaption: '완료 선언을 의심하고 감사를 트리거하는 신호 종류',
    problem: 'AI가 "완료했습니다"라고 보고해도 QA 캡처가 빠지거나 종료 코드가 틀린 경우가 있었습니다. 완료 선언 자체를 신뢰의 기준으로 삼을 수 없었습니다.',
    analysis: '완료 선언을 그대로 받아들이는 방식과, 별도 근거로 재감사하는 방식을 비교했습니다. QA 캡처 누락·종료 코드 오류·소스 해시 불일치·반복 차단 의심 네 가지 신호를 감사 트리거로 구체화했습니다.',
    result: '이 중 하나라도 걸리면 완료 선언과 별도로 승인·반려 근거를 다시 감사합니다. 측정도 같은 원칙입니다 — ToonCard 리렌더를 새로고침당 3회에서 1회로, 일일 OCR 호출을 약 160회에서 12회(93%↓)로 줄인 것도 체감이 아니라 직접 만든 측정 도구로 실측한 뒤에만 "개선됐다"고 기록했습니다.',
  },
  {
    title: '되돌릴 수 있게, 그리고 고칠 수 있게',
    skills: 'revert-change · pr-workflow · harness-evolve',
    stat: '0',
    statCaption: '복원할 때 대화 기록·모델의 기억에 의존하는 비율',
    problem: '"방금 한 거 되돌려줘" 요청을 대화 맥락에 의존해 처리하면, 세션이 길어지거나 컨텍스트가 요약될 때 복원 범위가 달라졌습니다.',
    analysis: '대화 기억에 의존하는 복원과 파일 스냅샷 기준 복원을 비교했습니다. 정확히 그 작업만 되돌리려면 대화와 무관한 별도의 기준점이 필요하다고 판단했습니다.',
    result: '코드 수정 착수 직전 스냅샷을 파일로 저장해, "되돌려줘" 요청이 오면 대화 기록 없이 스냅샷만으로 복원합니다. 결과가 아쉬우면 harness-evolve로 피드백을 일반화해 스킬·에이전트 자체를 고칩니다.',
  },
];
---

<section id="deep-dive" class="border-t border-line bg-bg text-ink">
  <div class="mx-auto grid grid-cols-1 max-w-6xl gap-10 px-5 py-24 md:grid-cols-[11rem_1fr] md:gap-12 md:py-36">
    <div class="animate-in">
      <h2 class="font-serif text-2xl italic md:sticky md:top-24 md:text-3xl">기술 메모</h2>
    </div>

    <div>
      <h3 class="text-2xl font-semibold leading-snug tracking-tight md:text-4xl">요청부터 회고까지, 같은 틀로 판단합니다</h3>
      <p class="mt-4 max-w-xl text-lg text-muted">의도를 확정하고 → 되돌릴 수 있게 만들고 → 근거로 완료를 판정하는 순서를 모든 프로젝트에 동일하게 적용합니다.</p>
      <p class="mt-10 text-xs tracking-wide text-muted">● 스킬로 처리 &nbsp;·&nbsp; ○ 스킬 없음, 사람의 판단 &nbsp;·&nbsp; ✦ 핵심 차별점</p>
      <ol class="relative mt-6 space-y-7">
        <FlowStep
          marker="hollow"
          title="사용자 문제 발굴"
          subtitle="스킬 없음 · 무엇을 만들지 고르는 단계"
          desc="AI가 대신 판단할 수 없는 단계입니다. 어떤 문제를 지금 풀어야 하는지는 제가 직접 정합니다."
        />
        <FlowStep title="요청 수신" desc="요청을 받는 시점입니다. 해결책이 아니라 그 뒤의 진짜 목표부터 확인하는 절차가 여기서 시작됩니다." />
        <FlowStep
          title="착수 전 스냅샷"
          subtitle="revert-change · chaengkim"
          desc="코드를 고치기 전에 현재 상태를 저장해 둡니다. 대화 기억이 아니라 파일 기준으로, 나중에 꼭 그 작업만 정확히 되돌릴 수 있게 하기 위해서입니다."
        />
        <FlowStep
          title="의도 확정 + GitHub 이슈"
          subtitle="clarify-intent · bugfix-cycle 위험 등급"
          desc="요청 뒤의 진짜 목표를 의도→원인→제약→해법 순으로 먼저 확정하고, 합의된 내용을 GitHub 이슈로 남깁니다. 버그 수정은 위험 등급을 매겨 낮은 위험은 중간 단계를 생략합니다."
        />
        <li class="relative pl-8">
          <span aria-hidden="true" class="absolute left-0 top-1 font-serif leading-none text-muted">?</span>
          <span class="font-serif italic text-muted">디자인이 필요한 작업인가요?</span>
          <span class="mt-0.5 block text-sm text-muted">아니오 → 바로 구현으로 · 예 → 아래 디자인 단계를 거침</span>
        </li>
        <FlowStep
          marker="branch"
          indent
          title="디자인: 방향 → 구체화 → 모션"
          subtitle="design-taste-frontend · frontend-design · design-flow · impeccable · animate"
          desc="트렌드 수집 → 방향 브리프 → Figma 구체화 → 모션 설계까지 한 흐름으로 고정합니다. 디자인 요청 한마디로 전체 파이프라인이 돌아갑니다."
        />
        <FlowStep
          title="구현 + Draft PR"
          subtitle="senior-frontend · pr-workflow · expo-dev-run"
          desc="이슈·브랜치·Draft PR·커밋·진행 댓글로 전 과정을 추적합니다. 네이티브 재빌드가 필요하면 자동으로 dev client·Metro를 복구합니다."
        />
        <FlowStep
          marker="highlight"
          title="검증: 근거로 완료 판정"
          subtitle="verify-solution · maestro-test (화면 13개) · evidence-audit"
          note="↺ 반려 시 구현으로 되돌아갑니다"
          desc={'정적 검사→단위→통합→E2E 순으로 확인합니다. EAS 빌드 전에는 주요 화면 흐름 13개를 자동 실행해 스크린샷 리포트를 생성합니다. AI의 "완료했습니다" 선언은 QA 캡처 누락·종료 코드 오류·소스 해시 불일치·반복 차단 의심 네 가지 신호로 다시 감사합니다.'}
        />
        <FlowStep
          title="머지 · 릴리스"
          subtitle="pr-workflow"
          note="출시 후 지표 측정은 아직 다루지 않습니다"
          noteTone="muted"
          desc="검증을 통과한 변경만 사용자 승인을 받은 뒤 머지합니다. 머지 후에는 로컬 main을 원격과 동기화합니다."
        />
        <FlowStep
          title="회고: 작업 체계 개선"
          subtitle="harness-evolve로 스킬 · 에이전트 수정"
          desc="머지·릴리스 후 결과가 아쉬우면 피드백을 일반화해 에이전트와 스킬 자체를 고칩니다. 같은 실수를 반복하지 않도록 프로세스를 스스로 개선합니다."
        />
      </ol>

      <div class="mt-20 md:mt-28">
        <h3 class="text-2xl font-semibold leading-snug tracking-tight md:text-4xl">이 흐름을 지탱하는 다섯 가지 원칙</h3>
        <p class="mt-4 max-w-xl text-lg text-muted">스킬 하나하나가 왜 그렇게 설계됐는지, 실제 사례와 수치로 봅니다.</p>

        <div class="mt-12 divide-y divide-line">
          {values.map((v, i) => (
            <div class="py-12 first:pt-0">
              <div class="grid grid-cols-1 gap-6 md:grid-cols-[6rem_1fr]">
                <span class="font-serif text-5xl italic leading-none text-accent">{String(i + 1).padStart(2, '0')}</span>
                <div class="min-w-0">
                  <h4 class="text-xl font-bold tracking-tight md:text-2xl">{v.title}</h4>
                  <p class="mt-1.5 text-sm text-muted">{v.skills}</p>

                  <div class="mt-6 overflow-hidden rounded-md border border-line">
                    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-l-2 border-accent bg-bg2 px-6 py-4">
                      <span class="font-serif text-3xl italic leading-none text-accent">{v.stat}</span>
                      <span class="text-sm text-muted">{v.statCaption}</span>
                    </div>
                    <div class="space-y-3 px-6 py-5 text-sm leading-relaxed text-muted">
                      <p><strong class="text-ink">문제</strong> {v.problem}</p>
                      <p><strong class="text-ink">분석</strong> {v.analysis}</p>
                      <p><strong class="text-ink">결과</strong> {v.result}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
