---
const steps = [
  {
    title: 'Find the Root Cause',
    desc: '재현되지 않는 버그일수록 로그와 커밋을 되짚으며 원인을 찾을 때까지 놓지 않습니다.',
  },
  {
    title: 'Remove the Repetition',
    desc: '같은 작업이 세 번 반복되면, 왜 반복되는지부터 파고들어 원인을 없앱니다.',
  },
  {
    title: 'Ship, Don’t Just Plan',
    desc: '머릿속 구상은 직접 동작하는 서비스로 만들어 세상에 내놓는 쪽을 선택합니다.',
  },
  {
    title: 'Revisit and Improve',
    desc: '예전 코드를 다시 보며 ‘지금이라면 이렇게 짰을 텐데’를 되새기는 것이 습관입니다.',
  },
];
---

<section id="approach" class="border-t border-line bg-bg text-ink">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-24 md:grid-cols-[11rem_1fr] md:gap-12 md:py-36">
    <div class="animate-in">
      <h2 class="font-serif text-2xl italic md:sticky md:top-24 md:text-3xl">일하는 방식</h2>
    </div>

    <div>
      <ol class="grid gap-x-12 gap-y-16 md:grid-cols-2">
        {steps.map((step, i) => (
          <div class="animate-in" style={`--stagger: ${i * 80}ms`}>
            <li>
              <span class="font-serif text-7xl italic leading-none text-accent md:text-8xl">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 font-display text-2xl font-bold tracking-tight md:text-3xl">{step.title}</h3>
              <p class="mt-3 max-w-sm text-muted">{step.desc}</p>
            </li>
          </div>
        ))}
      </ol>
    </div>
  </div>
</section>
