---
const steps = [
  {
    title: 'Own It End to End',
    desc: '기획부터 구현, 배포, 출시 후 운영까지 끝까지 책임지는 방식을 지향합니다.',
  },
  {
    title: 'Ship, Then Learn',
    desc: '완벽한 기획보다 돌아가는 결과물을 먼저 내고, 피드백과 실험으로 개선합니다.',
  },
  {
    title: 'Build AI-Native',
    desc: 'AI를 보조 도구가 아니라 기본 작업 방식으로 삼아, 만드는 시간보다 판단에 집중합니다.',
  },
  {
    title: 'Outcomes Over Output',
    desc: '기능 개수가 아니라 해결한 문제와 지표의 변화로 성과를 증명합니다.',
  },
];
---

<section id="approach" class="border-t border-line bg-bg text-ink">
  <div class="mx-auto grid grid-cols-1 max-w-6xl gap-10 px-5 py-24 md:grid-cols-[11rem_1fr] md:gap-12 md:py-36">
    <div class="animate-in">
      <h2 class="font-serif text-2xl italic md:sticky md:top-24 md:text-3xl">일하는 방식</h2>
    </div>

    <div>
      <ol class="grid gap-x-12 gap-y-16 md:grid-cols-2">
        {steps.map((step, i) => (
          <div class="animate-in" style={`--stagger: ${i * 80}ms`}>
            <li>
              <span class="font-serif text-7xl italic leading-none text-accent md:text-8xl">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 font-display text-2xl font-bold tracking-tight md:text-3xl">{step.title}</h3>
              <p class="mt-3 max-w-sm text-muted">{step.desc}</p>
            </li>
          </div>
        ))}
      </ol>
    </div>
  </div>
</section>
