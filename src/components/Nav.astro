---
const pathname = Astro.url.pathname;
const isBlog = pathname.startsWith('/blog');

const links = [
  { href: '/#about', label: '소개' },
  { href: '/#experience', label: '경력' },
  { href: '/#projects', label: '프로젝트' },
  { href: '/#apps', label: '작업 화면' },
  { href: '/#skills', label: '기술' },
  { href: '/#approach', label: '접근 방식' },
  { href: '/#contact', label: '연락' },
];
---

<header
  id="nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/90 backdrop-blur transition-colors"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5">
    <a href="/#top" class="font-display text-base font-bold tracking-tight">
      yunsung<span class="text-accent">.</span>
    </a>

    {isBlog ? (
      <a href="/" class="ulink text-sm font-medium">포트폴리오로 돌아가기 ↗</a>
    ) : (
      <>
        <ul class="hidden items-center gap-7 md:flex">
          {links.map((link) => (
            <li>
              <a href={link.href} class="text-sm transition text-muted hover:text-ink">
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/blog" class="text-sm transition text-muted hover:text-ink">Blog</a>
          </li>
        </ul>

        <div class="flex items-center gap-4">
          <button id="theme-toggle" class="text-sm transition hover:text-accent" aria-label="Toggle theme">
            Dark
          </button>
          <button
            id="mobile-menu-btn"
            class="text-sm transition hover:text-accent md:hidden"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            Menu
          </button>
        </div>
      </>
    )}
  </nav>

  {!isBlog && (
    <div id="mobile-nav" class="hidden border-t border-line px-5 pb-4 md:hidden">
      <ul class="flex flex-col gap-1 pt-3">
        {links.map((link) => (
          <li>
            <a href={link.href} class="block py-2 text-sm text-muted">{link.label}</a>
          </li>
        ))}
        <li><a href="/blog" class="block py-2 text-sm text-muted">Blog</a></li>
      </ul>
    </div>
  )}
</header>

<div class="h-14"></div>

<script>
  const themeBtn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function currentTheme() {
    if (root.dataset.theme === 'dark') return 'dark';
    if (root.dataset.theme === 'light') return 'light';
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function syncLabel() {
    if (themeBtn) themeBtn.textContent = currentTheme() === 'dark' ? 'Light' : 'Dark';
  }
  syncLabel();

  themeBtn?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
    syncLabel();
  });

  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-nav');

  menuBtn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
