---
const pathname = Astro.url.pathname;
const isBlog = pathname.startsWith('/blog');

const links = [
  { href: '/#about', label: '소개' },
  { href: '/#experience', label: '경력' },
  { href: '/#projects', label: '프로젝트' },
  { href: '/#skills', label: '기술' },
  { href: '/#approach', label: '접근 방식' },
  { href: '/#contact', label: '연락' },
];
---

<!-- 데스크톱: 왼쪽 고정 세로 사이드바 -->
<header
  id="nav"
  class="fixed inset-y-0 left-0 z-50 hidden w-56 flex-col justify-between border-r border-line bg-bg/90 px-6 py-8 backdrop-blur transition-colors md:flex"
>
  <div>
    <a href="/#top" class="font-display text-base font-bold tracking-tight">
      yunsung<span class="text-accent">.</span>
    </a>

    {isBlog ? (
      <a href="/" class="ulink mt-10 block text-sm font-medium">포트폴리오로 돌아가기 ↗</a>
    ) : (
      <ul class="mt-12 flex flex-col gap-1">
        {links.map((link) => (
          <li>
            <a href={link.href} class="block py-2 text-sm transition text-muted hover:text-ink">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  {!isBlog && (
    <button class="theme-toggle-btn self-start text-sm transition hover:text-accent" aria-label="Toggle theme">
      Dark
    </button>
  )}
</header>

<!-- 모바일: 상단 가로 바 + 드롭다운 메뉴 -->
<div id="mobile-bar" class="fixed inset-x-0 top-0 z-50 flex h-14 items-center justify-between border-b border-line bg-bg/90 px-5 backdrop-blur transition-colors md:hidden">
  <a href="/#top" class="font-display text-base font-bold tracking-tight">
    yunsung<span class="text-accent">.</span>
  </a>

  {isBlog ? (
    <a href="/" class="ulink text-sm font-medium">포트폴리오로 돌아가기 ↗</a>
  ) : (
    <div class="flex items-center gap-4">
      <button class="theme-toggle-btn text-sm transition hover:text-accent" aria-label="Toggle theme">
        Dark
      </button>
      <button
        id="mobile-menu-btn"
        class="text-sm transition hover:text-accent"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        Menu
      </button>
    </div>
  )}
</div>

{!isBlog && (
  <div id="mobile-nav" class="fixed inset-x-0 top-14 z-50 hidden border-b border-line bg-bg/90 px-5 pb-4 backdrop-blur md:hidden">
    <ul class="flex flex-col gap-1 pt-3">
      {links.map((link) => (
        <li>
          <a href={link.href} class="block py-2 text-sm text-muted">{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
)}

<div class="h-14 md:hidden"></div>

<script>
  const root = document.documentElement;

  function currentTheme() {
    if (root.dataset.theme === 'dark') return 'dark';
    if (root.dataset.theme === 'light') return 'light';
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  const themeBtns = document.querySelectorAll<HTMLButtonElement>('.theme-toggle-btn');

  function syncLabel() {
    themeBtns.forEach((btn) => {
      btn.textContent = currentTheme() === 'dark' ? 'Light' : 'Dark';
    });
  }
  syncLabel();

  themeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
      syncLabel();
    });
  });

  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-nav');

  menuBtn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
